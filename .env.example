# Contentful Configuration
# Get these values from your Contentful space settings
VITE_CONTENTFUL_SPACE_ID=your_space_id_here
VITE_CONTENTFUL_ACCESS_TOKEN=your_delivery_api_token_here
VITE_CONTENTFUL_MANAGEMENT_TOKEN=your_management_token_here

# Optional: Use preview API for draft content (requires preview token)
# VITE_CONTENTFUL_HOST=preview.contentful.com
# VITE_CONTENTFUL_PREVIEW_TOKEN=your_preview_token_here