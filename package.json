{
  "name": "rum-river-final",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "npm run tokens:build && vite build",
    "build:studio": "cd studio && npm run build",
    "deploy:studio": "cd studio && npm run deploy",
    "preview": "vite preview",
    "tokens:build": "style-dictionary build --config config.js",
    "tokens:watch": "nodemon --watch tokens --exec 'npm run tokens:build'",
    "admin:sync": "node local-admin/sync-to-contentful.mjs",
    "admin:watch": "node local-admin/sync-to-contentful.mjs --watch",
    "admin:edit": "code local-admin/content/homepage.json",
    "sanity": "scripts/sanity.sh",
    "sanity:debug": "scripts/sanity.sh debug",
    "sanity:query": "scripts/sanity.sh documents query",
    "sanity:dataset": "scripts/sanity.sh dataset list",
    "sanity:cors": "scripts/sanity.sh cors list",
    "sanity:schema:check": "scripts/sanity.sh schema check",
    "sanity:build": "scripts/sanity.sh build dist",
    "sanity:deploy": "scripts/sanity.sh deploy dist --no-build",
    "sanity:dev": "sanity dev"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@knight-lab/timelinejs": "^3.9.8",
    "@portabletext/react": "^4.0.3",
    "@sanity/client": "^7.12.0",
    "@sanity/image-url": "^1.2.0",
    "@sanity/vision": "^4.10.3",
    "contentful": "^11.8.6",
    "contentful-management": "^11.60.4",
    "dotenv": "^17.2.3",
    "groq": "^4.10.3",
    "masonic": "^4.1.0",
    "mime-types": "^3.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^7.9.3",
    "sanity": "^4.10.3",
    "styled-components": "^6.1.19",
    "yet-another-react-lightbox": "^3.25.0"
  },
  "devDependencies": {
    "@sanity/presentation": "^2.0.0",
    "@sanity/visual-editing": "^3.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "chokidar": "^4.0.3",
    "less": "^4.4.1",
    "style-dictionary": "^4.4.0",
    "vite": "^6.0.1"
  }
}
