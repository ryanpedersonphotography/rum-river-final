{
  "name": "rum-river-studio",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "sanity dev",
    "build": "sanity build ../studio-dist",
    "deploy": "sanity deploy ../studio-dist --no-build",
    "clean": "rm -rf ../studio-dist",
    "qa": "npm run qa:strict && npm run qa:homepage",
    "qa:strict": "node scripts/qa-strict-validation.mjs",
    "qa:homepage": "node scripts/qa-homepage.mjs",
    "cleanup:fields": "node scripts/cleanup-unknown-fields.mjs --execute",
    "cleanup:scan": "node scripts/cleanup-unknown-fields.mjs",
    "fix:venue": "node scripts/fix-venue-discovery.mjs",
    "fix:testimonials": "node scripts/fix-testimonials-fields.mjs"
  },
  "dependencies": {
    "@sanity/vision": "^3.70.0",
    "styled-components": "^6.1.19"
  },
  "devDependencies": {
    "@sanity/cli": "^4.13.0",
    "sanity": "^4.13.0"
  }
}
