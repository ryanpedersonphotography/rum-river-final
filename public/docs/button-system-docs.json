        "name": "Navigation Link",
        "description": "Styled links that look like buttons",
        "current": "<CTAButton variant=\"primary\" to=\"/contact\">Contact Us</CTAButton>",
        "shadcn": "<Button variant=\"default\" asChild><Link to=\"/contact\">Contact Us</Link></Button>"
