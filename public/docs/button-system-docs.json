  "troubleshooting": {
    "commonIssues": [
      {
        "issue": "Styling differences after migration",
        "solution": "Use cn() utility to combine shadcn classes with custom styles",
        "example": "className={cn(\"bg-rose-400 hover:bg-amber-900\", className)}"
      },
      {
        "issue": "Link buttons not working",
        "solution": "Use asChild prop with appropriate child element",
        "example": "<Button asChild><Link to=\"/path\">Text</Link></Button>"
      },
      {
        "issue": "Icons not displaying correctly",
        "solution": "Import correct Lucide icon and use proper className",
        "example": "import { Calendar } from 'lucide-react'"
      },
      {
        "issue": "Custom variants not matching design",
        "solution": "Create custom variant classes and use with cn() utility",
        "example": "Use design tokens for consistent styling"
      }
    ]
  },

  "codeExamples": {
    "imports": {
      "current": "import CTAButton from '../components/CTAButton'\nimport Icon from '../components/Icon'",
      "shadcn": "import { Button } from '@/components/ui/button'\nimport { Calendar, Camera, ArrowRight, Phone, Mail } from 'lucide-react'\nimport { Link } from 'react-router-dom'\nimport { cn } from '@/lib/utils'"
    },
    "basicUsage": {
      "current": "// Current CTAButton usage\n<CTAButton variant=\"primary\">Click Me</CTAButton>\n<CTAButton variant=\"outline\" size=\"large\">Outline Large</CTAButton>\n<CTAButton variant=\"primary\" disabled>Disabled</CTAButton>",
      "shadcn": "// Shadcn Button usage\n<Button variant=\"default\">Click Me</Button>\n<Button variant=\"outline\" size=\"lg\">Outline Large</Button>\n<Button variant=\"default\" disabled>Disabled</Button>"
    },
    "withLinks": {
      "current": "// Current link buttons\n<CTAButton variant=\"primary\" href=\"/gallery\">External Link</CTAButton>\n<CTAButton variant=\"outline\" to=\"/contact\">Router Link</CTAButton>",
      "shadcn": "// Shadcn link buttons\n<Button variant=\"default\" asChild>\n  <a href=\"/gallery\">External Link</a>\n</Button>\n<Button variant=\"outline\" asChild>\n  <Link to=\"/contact\">Router Link</Link>\n</Button>"
    },
    "withIcons": {
      "current": "// Current icon buttons\n<CTAButton variant=\"primary\">\n  <Icon name=\"calendar\" size=\"sm\" color=\"white\" />\n  Schedule Visit\n</CTAButton>",
      "shadcn": "// Shadcn icon buttons\n<Button variant=\"default\">\n  <Calendar className=\"mr-2 h-4 w-4\" />\n  Schedule Visit\n</Button>"
    },
    "customStyling": {
      "current": "// Current custom styling\n<CTAButton variant=\"vr-special\" className=\"my-custom-class\">\n  Special Action\n</CTAButton>",
      "shadcn": "// Shadcn custom styling\n<Button \n  variant=\"default\" \n  className={cn(\n    \"bg-gradient-to-r from-amber-900 to-stone-800\",\n    \"hover:from-amber-800 hover:to-stone-700\",\n    \"my-custom-class\"\n  )}\n>\n  Special Action\n</Button>"
    }
  }
