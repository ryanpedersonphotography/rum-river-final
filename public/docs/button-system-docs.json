    "sizes": [
      {
        "name": "small",
        "description": "Smaller padding and font size",
        "usage": "<CTAButton size=\"small\">Small</CTAButton>"
      },
      {
        "name": "normal",
        "description": "Default size (can be omitted)",
        "usage": "<CTAButton>Normal</CTAButton>"
      },
      {
        "name": "large",
        "description": "Larger padding and font size",
        "usage": "<CTAButton size=\"large\">Large</CTAButton>"
      }
    ],
    "props": {
      "variant": {
        "type": "string",
        "default": "primary",
        "options": ["primary", "outline", "vr-special", "vr-barn", "vr-bridal", "submit", "floating"],
        "description": "Visual style variant of the button"
      },
      "size": {
        "type": "string",
        "default": "normal", 
        "options": ["small", "normal", "large"],
        "description": "Size of the button"
      },
      "href": {
        "type": "string",
        "description": "External link URL (renders as <a> tag)"
      },
      "to": {
        "type": "string",
        "description": "React Router path (renders as <Link> component)"
      },
      "onClick": {
        "type": "function",
        "description": "Click event handler"
      },
      "disabled": {
        "type": "boolean",
        "default": false,
        "description": "Disabled state"
      },
      "type": {
        "type": "string",
        "default": "button",
        "options": ["button", "submit", "reset"],
        "description": "Button type attribute"
      },
      "className": {
        "type": "string",
        "description": "Additional CSS classes"
      },
      "ariaLabel": {
        "type": "string",
        "description": "Accessibility label"
      },
      "target": {
        "type": "string",
        "description": "Link target (for href prop)"
      },
      "rel": {
        "type": "string",
        "description": "Link relationship (for href prop)"
      }
    }
  },

  "shadcnMigration": {
    "targetComponent": "@/components/ui/button",
    "installation": "npx shadcn-ui@latest add button",
    "variantMappings": {
      "primary": "default",
      "outline": "outline",
      "vr-special": "default + custom className",
      "vr-barn": "secondary + custom className", 
      "vr-bridal": "outline + custom className",
      "submit": "default + type=\"submit\"",
      "floating": "default + fixed positioning"
    },
    "sizeMappings": {
      "small": "sm",
      "normal": "default",
      "large": "lg"
    },
    "migrationExamples": [
      {
        "description": "Simple primary button",
        "before": "<CTAButton variant=\"primary\">Click Me</CTAButton>",
        "after": "<Button variant=\"default\">Click Me</Button>"
      },
      {
        "description": "Outline button",
        "before": "<CTAButton variant=\"outline\">Click Me</CTAButton>",
        "after": "<Button variant=\"outline\">Click Me</Button>"
      },
      {
        "description": "Large primary button",
        "before": "<CTAButton variant=\"primary\" size=\"large\">Click Me</CTAButton>",
        "after": "<Button variant=\"default\" size=\"lg\">Click Me</Button>"
      },
      {
        "description": "External link button",
        "before": "<CTAButton variant=\"primary\" href=\"/gallery\">View Gallery</CTAButton>",
        "after": "<Button variant=\"default\" asChild><a href=\"/gallery\">View Gallery</a></Button>"
      },
      {
        "description": "Router link button",
        "before": "<CTAButton variant=\"outline\" to=\"/contact\">Contact</CTAButton>",
        "after": "<Button variant=\"outline\" asChild><Link to=\"/contact\">Contact</Link></Button>"
      },
      {
        "description": "Button with icon",
        "before": "<CTAButton variant=\"primary\"><Icon name=\"calendar\" size=\"sm\" color=\"white\" />Schedule</CTAButton>",
        "after": "<Button variant=\"default\"><Calendar className=\"mr-2 h-4 w-4\" />Schedule</Button>"
      },
      {
        "description": "Disabled button",
        "before": "<CTAButton variant=\"primary\" disabled>Coming Soon</CTAButton>",
        "after": "<Button variant=\"default\" disabled>Coming Soon</Button>"
      },
      {
        "description": "Submit button",
        "before": "<CTAButton variant=\"submit\">Submit Form</CTAButton>",
        "after": "<Button variant=\"default\" type=\"submit\">Submit Form</Button>"
      }
    ]
  },

  "iconMigration": {
    "from": "Custom Icon component",
    "to": "Lucide React",
    "installation": "npm install lucide-react",
    "mappings": [
      {
        "current": "<Icon name=\"calendar\" size=\"sm\" color=\"white\" />",
        "shadcn": "<Calendar className=\"mr-2 h-4 w-4\" />",
        "notes": "Import: import { Calendar } from 'lucide-react'"
      },
      {
        "current": "<Icon name=\"camera\" size=\"sm\" color=\"dusty-rose\" />",
        "shadcn": "<Camera className=\"mr-2 h-4 w-4\" />",
        "notes": "Import: import { Camera } from 'lucide-react'"
      },
      {
        "current": "<Icon name=\"arrow-right\" size=\"sm\" color=\"white\" />",
        "shadcn": "<ArrowRight className=\"ml-2 h-4 w-4\" />",
        "notes": "Import: import { ArrowRight } from 'lucide-react'"
      },
      {
        "current": "<Icon name=\"phone\" size=\"sm\" color=\"white\" />",
        "shadcn": "<Phone className=\"mr-2 h-4 w-4\" />",
        "notes": "Import: import { Phone } from 'lucide-react'"
      },
      {
        "current": "<Icon name=\"mail\" size=\"sm\" color=\"dusty-rose\" />",
        "shadcn": "<Mail className=\"mr-2 h-4 w-4\" />",
        "notes": "Import: import { Mail } from 'lucide-react'"
      }
    ],
    "sizeMappings": {
      "sm": "h-4 w-4",
      "md": "h-5 w-5", 
      "lg": "h-6 w-6"
    },
    "positioningClasses": {
      "leading": "mr-2",
      "trailing": "ml-2"
    }
  },

  "tokenIntegration": {
    "tokenSystem": "Style Dictionary",
    "tokenFile": "src/generated/tokens.css",
    "buttonTokens": {
      "colors": {
        "primary-bg": "var(--color-semantic-button-primary-bg)",
        "primary-text": "var(--color-semantic-button-primary-text)",
        "primary-hover-bg": "var(--color-semantic-button-primary-hover-bg)",
        "outline-border": "var(--color-semantic-button-outline-border)",
        "outline-text": "var(--color-semantic-button-outline-text)",
        "outline-hover-bg": "var(--color-semantic-button-outline-hover-bg)",
        "outline-hover-text": "var(--color-semantic-button-outline-hover-text)"
      },
      "spacing": {
        "padding-sm": "var(--spacing-sm) var(--spacing-lg)",
        "padding-default": "var(--spacing-md) var(--spacing-xl)",
        "padding-lg": "var(--spacing-lg) var(--spacing-2xl)"
      },
      "typography": {
        "font-family": "var(--font-family-body)",
        "font-size-sm": "var(--font-size-sm)",
        "font-size-default": "var(--font-size-base)",
        "font-size-lg": "var(--font-size-lg)",
        "font-weight": "var(--font-weight-medium)"
      },
      "borders": {
        "radius": "var(--size-border-radius-pill)",
        "width": "var(--size-border-width-medium)"
      },
      "effects": {
        "transition": "var(--transition-preset-default)",
        "shadow": "var(--shadow-sm)",
        "shadow-hover": "var(--shadow-md)"
      }
    },
    "darkModeSupport": {
      "strategies": [":root.dark", "html[data-theme=\"dark\"]"],
      "colorMixSupport": true,
      "fallbacks": "Graceful degradation for older browsers"
    }
  },

  "usagePatterns": {
    "common": [
      {
        "name": "Primary CTA",
        "description": "Main call-to-action button on pages",
